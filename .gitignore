# ---- Claude / AI assistant working files (never published) ----
.claude/

# ---- Desktop environment cruft ----
.directory
.DS_Store

# ---- Obsidian vault config (themes, workspace state — not project files) ----
.obsidian/

# ---- Staging area for files Claude cannot delete over the device bridge ----
_to_delete/

# ---- Python ----
__pycache__/
*.py[codz]
*$py.class
build/
dist/
*.egg-info/
*.egg
MANIFEST
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---- Compiled GSettings schema (regenerated by glib-compile-schemas) ----
data/gschemas.compiled

# ---- makepkg build artifacts (PKGBUILD lives in build-aux/) ----
build-aux/src/
build-aux/pkg/
*.pkg.tar.zst
*.pkg.tar.zst.sig

# ---- Flatpak build artifacts ----
# .flatpak-builder is flatpak-builder's default --state-dir
# (downloads, build dirs, build cache)
.flatpak-builder/
builddir/
repo/
*.flatpak

# ---- Editors ----
.vscode/
.idea/
*.swp
*~
