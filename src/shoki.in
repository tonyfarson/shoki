#!/usr/bin/env python3
"""Installed launcher for Shoki.

Generated by Meson from shoki.in. Shoki installs to pkgdatadir rather than
site-packages so that one mechanism works under /usr, under a Flatpak's /app,
and under a throwaway test prefix. See src/meson.build.
"""

import sys

sys.path.insert(1, '@PKGDATADIR@')

from shoki.main import main

sys.exit(main())
